def main():
    client = TestClient(app)

    expected = [(text, label) for label, texts in SENTENCES.items() for text in texts]
    sentences = [text for text, _ in expected]

    response = client.post(
        "/sentiment",
        json={"sentences": sentences},
        headers={"Origin": "https://exam.sanand.workers.dev"},
    )
    assert response.status_code == 200, response.text
    assert response.headers.get("access-control-allow-origin") == "*", "CORS header missing"

    results = response.json()["results"]
    assert len(results) == len(expected), "wrong number of results"

    wrong = []
    for (text, label), result in zip(expected, results):
        assert result["sentence"] == text, "sentences are out of order"
        if result["sentiment"] != label:
            wrong.append(f"{text!r}: expected {label}, got {result['sentiment']}")

    print(f"{len(expected) - len(wrong)}/{len(expected)} sentences correct")
    for line in wrong:
        print("WRONG", line)
    raise SystemExit(1 if wrong else 0)


if __name__ == "__main__":
    main()

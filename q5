def main():
    client = TestClient(app)
    failures = []

    # Preflight exactly as the browser sends it from the exam page.
    preflight = client.options(
        "/code-interpreter",
        headers={
            "Origin": "https://exam.sanand.workers.dev",
            "Access-Control-Request-Method": "POST",
            "Access-Control-Request-Headers": "content-type",
        },
    )
    if preflight.status_code != 200 or "access-control-allow-origin" not in preflight.headers:
        failures.append(f"CORS preflight failed: {preflight.status_code} {dict(preflight.headers)}")

    for case_id, code, expected_output in Q5_SUCCESS_CASES:
        response = client.post("/code-interpreter", json={"code": code})
        body = response.json()
        ok = (
            response.status_code == 200
            and "application/json" in response.headers["content-type"]
            and isinstance(body.get("error"), list)
            and isinstance(body.get("result"), str)
            and body["error"] == []
            and body["result"] == expected_output
        )
        if not ok:
            failures.append(f"success case {case_id}: got {body!r}")

    for case_id, code, expected_lines in Q5_ERROR_CASES:
        response = client.post("/code-interpreter", json={"code": code})
        body = response.json()
        ok = (
            response.status_code == 200
            and isinstance(body.get("error"), list)
            and isinstance(body.get("result"), str)
            and sorted(body["error"]) == sorted(expected_lines)
            and ("Traceback" in body["result"] or "Error" in body["result"])
        )
        if not ok:
            failures.append(f"error case {case_id}: expected {expected_lines}, got {body!r}")

    total = len(Q5_SUCCESS_CASES) + len(Q5_ERROR_CASES)
    print(f"{total - len([f for f in failures if 'case' in f])}/{total} cases passed")
    for failure in failures:
        print("FAIL", failure)
    raise SystemExit(1 if failures else 0)


if __name__ == "__main__":
    main()
